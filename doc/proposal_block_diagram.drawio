                <mxCell id="201" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Monitor&lt;/font&gt;&lt;/b&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
